# Copie para .env e troque os valores:   cp .env.example .env
# O .env fica FORA do Git (já está no .gitignore).
#
# Gere senhas e segredos com:   openssl rand -hex 16
# Evite @ : / $ # e aspas: algumas senhas entram em URLs de conexão.

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=troque-esta-senha

# --- PostgreSQL --------------------------------------------------------------
# Um usuário para todos os bancos (metastore, airflow, metabase, fonte).
POSTGRES_USER=gabs
POSTGRES_PASSWORD=troque-esta-senha

# --- Airflow -----------------------------------------------------------------
# Segredo que os componentes do Airflow usam para se autenticar entre si.
AIRFLOW_JWT_SECRET=troque-este-segredo

# --- Jupyter -----------------------------------------------------------------
JUPYTER_TOKEN=troque-este-token
SPARK_DRIVER_MEMORY=1g

# --- Rede --------------------------------------------------------------------
# 127.0.0.1 = telas acessíveis só da própria máquina (use túnel SSH).
# 0.0.0.0   = acessíveis de qualquer computador da rede (servidor de casa).
#             Nunca use 0.0.0.0 numa VM na nuvem.
BIND_ADDR=127.0.0.1

# --- Usuário da máquina ------------------------------------------------------
# Rode "id -u" e "id -g" no terminal e coloque os números aqui.
HOST_UID=1000
HOST_GID=1000
