# Copie para .env e troque as senhas:   cp .env.example .env
# O .env fica FORA do Git (já está no .gitignore).

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=admin
# mínimo de 8 caracteres
MINIO_ROOT_PASSWORD=troque-esta-senha

# --- Jupyter -----------------------------------------------------------------
# Senha de acesso ao JupyterLab
JUPYTER_TOKEN=troque-este-token

# --- Spark -------------------------------------------------------------------
# Memória do Spark. Com VM de 16 GB use 4g; com 32 GB pode subir para 8g.
SPARK_DRIVER_MEMORY=4g

# --- Usuário da máquina ------------------------------------------------------
# Rode "id -u" e "id -g" no terminal e coloque os números aqui. Isso faz os
# notebooks salvos pertencerem a você, e não ao root.
HOST_UID=1000
HOST_GID=1000
