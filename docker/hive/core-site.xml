<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuração do Hadoop usada pelo Metastore para acessar o MinIO.
     As credenciais vêm de AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY. -->
<configuration>
  <property>
    <name>fs.s3a.endpoint</name>
    <value>http://minio:9000</value>
  </property>
  <property>
    <name>fs.s3a.path.style.access</name>
    <value>true</value>
  </property>
  <property>
    <name>fs.s3a.connection.ssl.enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>fs.s3a.impl</name>
    <value>org.apache.hadoop.fs.s3a.S3AFileSystem</value>
  </property>
</configuration>
